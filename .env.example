# Copy to .env for local Docker Compose development: cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Database ---
# These configure the `db` (postgres) service AND how the app containers reach
# it — config/database.yml reads POSTGRES_* to build each env's connection, so
# there's no DATABASE_URL (a URL would force every env onto one database).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=watch_only_portfolio_development
# Host/port the web/worker containers use to reach the `db` service.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host port Postgres is published on (change if 5433 clashes locally).
DB_HOST_PORT=5433

# --- Rails ---
RAILS_ENV=development
# Host port the web app is published on (change if 3001 clashes locally).
WEB_HOST_PORT=3001

# --- External API keys ---
# DeBank Cloud Open API AccessKey (Milestone 2 — EVM balances). Prepaid units per call.
# Blank is fine for tests (they replay VCR cassettes); required to fetch live data.
DEBANK_ACCESS_KEY=
# COINGECKO_API_KEY=
# Solana provider (Zerion or CoinStats):
# SOLANA_API_KEY=
# OAuth (Google / Apple) — added with the auth milestone:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
