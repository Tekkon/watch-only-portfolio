# Copy to .env for local Docker Compose development: cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Database ---
# These configure the `db` (postgres) service.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=watch_only_portfolio_development
# How the app containers (web/worker) reach the db service. Overrides database.yml.
DATABASE_URL=postgres://app:app@db:5432/watch_only_portfolio_development
# Host port Postgres is published on (change if 5433 clashes locally).
DB_HOST_PORT=5433

# --- Rails ---
RAILS_ENV=development
# Host port the web app is published on (change if 3001 clashes locally).
WEB_HOST_PORT=3001

# --- External API keys ---
# DeBank Cloud Open API AccessKey (Milestone 2 — EVM balances). Prepaid units per call.
# Blank is fine for tests (they replay VCR cassettes); required to fetch live data.
DEBANK_ACCESS_KEY=
# COINGECKO_API_KEY=
# Solana provider (Zerion or CoinStats):
# SOLANA_API_KEY=
# OAuth (Google / Apple) — added with the auth milestone:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
